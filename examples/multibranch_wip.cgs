# Work-in-progress snapshot of the multi-branch workspace, 2026-09-07.
#
# Rebuilds the exact tree the MultiBranchSync work was left in: the two
# project repositories on the feature branch "multi-branch", and each
# configuration repository on the branch it is pinned to. Run it from a
# fresh clone of ComplexGitSync -- see
# AgentSpec/MultiBranchResume_DevPlanTicket.md for the two commands.
#
# This is a restore point, not the project's topology. install.cgs stays
# the file that describes ComplexGitSync normally, on main. Delete this one
# once multi-branch has merged.
#
# writable = true is read only by the code on the multi-branch branch. An
# older cgitsync ignores unknown keys, so bootstrapping this file with
# main's code works and simply does not enforce the read-only rule until
# the checkout is on multi-branch.

project = { name = "ComplexGitSync", default_branch = "multi-branch" }

repos = [
    # The project's own repositories -- both carry the work in progress.
    { repository = "github:flipoyo/ComplexGitSync", default_branch = "multi-branch", fallback_branch = "main" },
    { repository = "github:flipoyo/DocComplexGitSync", default_branch = "multi-branch", fallback_branch = "main", relative_path = "docs", nested_config = "auto" },

    # Configuration repositories: shared with other projects, so they stay
    # on their own branch rather than following multi-branch.
    # Read-only -- every project that mounts .agentSpec reads this branch.
    { repository = "github:flipoyo/.agentSpec", default_branch = "main", fallback_branch = "main", nested_config = "auto", private = true },
    # Writable -- pinned to a branch named after this project, which nobody
    # else reads.
    { repository = "github:flipoyo/.localSpec", default_branch = "ComplexGitSync", fallback_branch = "main", private = true, writable = true },
    { repository = "github:flipoyo/.claude", default_branch = "ComplexGitSync", fallback_branch = "main", private = true, writable = true },
]
