# Nested documentation tree. DocComplexGitSync is inferred as the root and
# DocSpec keeps automatic discovery disabled.

project = { name = "DocComplexGitSync", default_branch = "autoTest" }

repos = [
    { repository = "github:flipoyo/DocComplexGitSync", fallback_branch = "main" },
    { repository = "github:flipoyo/DocSpec", fallback_branch = "main", nested_config = "disabled" },
]
