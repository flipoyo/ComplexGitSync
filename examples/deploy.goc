# ComplexGitSync self-standing orchestration script
# ──────────────────────────────────────────────────────────────────────────────
# This .goc (Git Orchestration Command) file defines the sequence of
# ComplexGitSync operations to run for a self-standing ComplexGitSync setup
# workflow. The plan targets the shared autoTest branch and lets each repo
# fall back to main according to complexgitsync.cgs. Load it programmatically
# with GocDocument.from_toml().

[document]
format_version = "1.0"

# ── Session defaults ────────────────────────────────────────────────────────
# These values apply to every action in the sequence unless overridden by
# an individual action's [actions.session] override table (reserved for v2).

[session]
interaction = "interactive"   # interactive | direct
profile     = "verbose"       # verbose | whisper_sync
transport   = "ssh"           # ssh | https

# ── Project entry-point ─────────────────────────────────────────────────────
# Set source to a .cgs path for tree git commands (clone, checkout, pull,
# add, commit, push, tag, freeze) or a .gts path for replay via pull.

[project]
source = "complexgitsync.cgs"
name   = "ComplexGitSync"      # project display name
repo_name = "ComplexGitSync"   # repository slug (distinct from project display name)
gitprovider = "github"         # github | gitlab
project_owner_name = "flipoyo" # required for github address composition
# gitprovider_address (computed with transport=ssh):
# git@github.com:flipoyo/ComplexGitSync.git

# ── Action sequence ─────────────────────────────────────────────────────────
# Actions are executed in order.  Each [[actions]] entry carries a mandatory
# 'command' key and an optional [actions.args] sub-table for command-specific
# parameters.

[[actions]]
# 1. Clone the full project tree into the current directory.
command = "clone"
[actions.args]
# target_dir = "./workspace"   # uncomment to clone into a subdirectory

[[actions]]
# 2. Ensure the whole tree prefers autoTest and can fall back to main.
command = "checkout"
[actions.args]
ref      = "autoTest"
ref_type = "branch"

[[actions]]
# 3. Pull the full tree from the configured source contract.
command = "pull"
