# CaWaQS-Viz deployment orchestration script
# ──────────────────────────────────────────────────────────────────────────────
# This .goc (Git Orchestration Command) file defines the sequence of
# ComplexGitSync operations to run for the standard CaWaQS-Viz deployment
# workflow. The plan targets the shared autoTest branch and lets each repo
# fall back to main according to cawaqsviz.cgs. Load it programmatically
# with GocDocument.from_toml().

[document]
format_version = "1.0"

# ── Session defaults ────────────────────────────────────────────────────────
# These values apply to every action in the sequence unless overridden by
# an individual action's [actions.session] override table (reserved for v2).

[session]
interaction = "interactive"   # interactive | direct
profile     = "verbose"       # verbose | whisper_sync
transport   = "ssh"           # ssh | https

# ── Project entry-point ─────────────────────────────────────────────────────
# Set source to a .cgs path for tree git commands (pull, checkout, add,
# commit, push, tag, freeze) or a .gts path for replay via pull.

[project]
source = "cawaqsviz.cgs"
name   = "CaWaQS-ViZ"          # project display name
repo_name = "cawaqsviz"        # repository slug (distinct from project display name)
gitprovider = "gitlab"         # github | gitlab | codeberg | custom
project_owner_name = "gviz/cawaqsviz"  # GitLab namespace fallback when group_name is omitted
# gitprovider_address (computed with transport=ssh):
# git@gitlab.com:gviz/cawaqsviz/cawaqsviz.git

# ── Action sequence ─────────────────────────────────────────────────────────
# Actions are executed in order.  Each [[actions]] entry carries a mandatory
# 'command' key and an optional [actions.args] sub-table for command-specific
# parameters.

[[actions]]
# 1. Resynchronise the full project tree from the configured source.
command = "pull"

[[actions]]
# 2. Switch the whole tree to autoTest, with main as the repo-level fallback.
command = "checkout"
[actions.args]
ref      = "autoTest"
ref_type = "branch"

[[actions]]
# 3. Pull the full tree from the configured source contract.
command = "pull"
