# CaWaQS-Viz uses autoTest globally and falls back to main. Only values that
# differ from normal .cgs defaults are declared on repository entries.

project = { name = "CaWaQS-Viz", default_branch = "autoTest" }

repos = [
    { repository = "gitlab:gviz/cawaqsviz/CaWaQS-Viz", fallback_branch = "main" },
    { repository = "github:flipoyo/HydrologicalTwinAlphaSeries", fallback_branch = "main" },
    { repository = "github:flipoyo/CWV_user_guide", fallback_branch = "main", nested_config = "disabled" },
]
