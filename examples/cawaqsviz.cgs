# Real-world topology for https://gitlab.com/cawaqs/gviz/cawaqsviz.
# Corrected 2026-08-24 (Onboarding_DevPlanTicket.md Phase 1) after
# verifying the live repository: the previous root identifier
# ("gitlab:gviz/cawaqsviz/CaWaQS-Viz") pointed at a nonexistent address,
# "autoTest" is not a real branch on cawaqsviz (it has exactly one, main),
# and "github:flipoyo/CWV_user_guide" 404s — the real GitHub repo is
# user_guide_CaWaQS-Viz; CWV_user_guide is only its local directory name.
# relative_path is explicit everywhere rather than relying on the
# name-matching auto-mount convention (cgs_format.py:187-209).
# nested_config = "disabled" on both children: neither
# HydrologicalTwinAlphaSeries nor user_guide_CaWaQS-Viz has a .cgs of its
# own (verified against the live repos), so the default "auto" nested
# discovery would fail looking for one that doesn't exist.

project = { name = "CaWaQS-Viz", default_branch = "main" }

repos = [
    { repository = "gitlab:cawaqs/gviz/cawaqsviz", relative_path = ".", fallback_branch = "main" },
    { repository = "github:flipoyo/HydrologicalTwinAlphaSeries", relative_path = "external/HydrologicalTwinAlphaSeries", fallback_branch = "main", nested_config = "disabled" },
    { repository = "github:flipoyo/user_guide_CaWaQS-Viz", relative_path = "docs/CWV_user_guide", fallback_branch = "main", nested_config = "disabled" },
]
