# Nested CGSih2 topology. The CGSih1 entry is the cycle back-reference, so its
# parent-relative path and disabled discovery are explicit advanced overrides.

project = "CGSih2"

repos = [
    "github:flipoyo/CGSih2",
    { repository = "github:flipoyo/CGSih1", relative_path = "..", nested_config = "disabled" },
]
