# Nested CGSil2 topology. The CGSih1 cross-reference needs overrides because
# it points to a sibling and must not trigger another nested scan.

project = "CGSil2"

repos = [
    "gitlab:CGS_test/CGSil2",
    { repository = "github:flipoyo/CGSih1", relative_path = "../CGSih1", nested_config = "disabled" },
]
